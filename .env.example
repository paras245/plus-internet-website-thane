# Plus Internet - Environment Configuration Template
# Copy this file to .env or .env.local for local development.

# GEMINI_API_KEY: Optional - API key for Google Gemini AI calls.
# If utilizing Gemini API, provide your key from Google AI Studio.
GEMINI_API_KEY=""
VITE_GEMINI_API_KEY=""

# APP_URL: The base URL where this application is hosted.
# Default for local development is http://localhost:3000
APP_URL="http://localhost:3000"
VITE_APP_URL="http://localhost:3000"

# Server configuration
PORT=3000
HOST="0.0.0.0"
